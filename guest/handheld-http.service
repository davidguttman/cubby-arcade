[Unit]
Description=Local offline handheld games
After=network.target

[Service]
User=arcade
WorkingDirectory=/opt/handheld
ExecStart=/usr/bin/python3 /opt/handheld/runtime/server.py
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/handheld
PrivateTmp=true

[Install]
WantedBy=multi-user.target
